# HTML y rutas SPA: siempre revalidar (evita chunks viejos tras deploy)
/
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/sobre-nosotros*
  Cache-Control: public, max-age=0, must-revalidate

/services*
  Cache-Control: public, max-age=0, must-revalidate

/formacion-empresas*
  Cache-Control: public, max-age=0, must-revalidate

/clientes*
  Cache-Control: public, max-age=0, must-revalidate

/blog*
  Cache-Control: public, max-age=0, must-revalidate

/contact*
  Cache-Control: public, max-age=0, must-revalidate

/faq*
  Cache-Control: public, max-age=0, must-revalidate

/trabaja-con-nosotros*
  Cache-Control: public, max-age=0, must-revalidate

/consultora-ia*
  Cache-Control: public, max-age=0, must-revalidate

/consultora-tecnologica*
  Cache-Control: public, max-age=0, must-revalidate

/automatizacion-empresas*
  Cache-Control: public, max-age=0, must-revalidate

# 404 de assets: nunca cachear (evita envenenar el edge con HTML/404)
/assets/404.html
  Cache-Control: no-store
  X-Content-Type-Options: nosniff

# Assets hasheados por Vite: caché larga solo en JS/CSS/map (no en 404.html)
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Access-Control-Allow-Origin: *

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Access-Control-Allow-Origin: *

/assets/*.js.map
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Imágenes estáticas
/hero/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/sections/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/partners/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/blog/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/llms.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
/ai.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
/robots.txt
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

# Seguridad base
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
